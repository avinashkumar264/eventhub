// EventHub — Prisma schema
// Day 2: database foundation only. No auth/payment/chat logic here —
// this models data shape for future days.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  VENDOR
  FREELANCER
  OPERATIONS
  ADMIN
}

enum ProviderType {
  EVENT_COMPANY
  FREELANCER
}

// Specialties a FREELANCER-type provider can offer.
enum FreelancerSpecialty {
  PHOTOGRAPHY
  MEHENDI
  DESIGNING
  MAKEUP
  FACIAL
  DECORATION
  CATERING
  OTHER
}

enum EventStatus {
  DRAFT
  OPEN
  QUOTATIONS_RECEIVED
  BOOKED
  COMPLETED
  CANCELLED
}

enum EventRequestStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  EXPIRED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  BALANCE
  FULL
  REFUND
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum NotificationType {
  LEAD
  QUOTATION
  BOOKING
  PAYMENT
  MESSAGE
  SYSTEM
}

// Governs the communication rule:
// OPERATIONS_MEDIATED — before verified advance payment (Customer -> Ops -> Vendor)
// DIRECT              — after verified advance payment (Customer <-> Vendor)
enum ConversationChannel {
  OPERATIONS_MEDIATED
  DIRECT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  firstName    String
  lastName     String
  role         UserRole @default(CUSTOMER)
  passwordHash String? // hashed with bcrypt, never plaintext
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider? // populated when role = VENDOR or FREELANCER

  events              Event[]
  eventRequests       EventRequest[]
  bookingsAsCustomer  Booking[]              @relation("BookingCustomer")
  paymentsMade        Payment[]
  reviewsWritten      Review[]
  notifications       Notification[]
  conversations       ConversationParticipant[]
  messagesSent        Message[]
  supportTickets      SupportTicket[]
  auditLogs           AuditLog[]

  @@index([role])
}

// A vendor or freelancer profile. One-to-one with a User whose role is VENDOR or FREELANCER.
model Provider {
  id                  String               @id @default(cuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                ProviderType
  freelancerSpecialty FreelancerSpecialty? // set only when type = FREELANCER
  businessName        String
  bio                 String?
  city                String?
  experienceYears     Int?
  verified            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  services      Service[]
  leads         Lead[]
  quotations    Quotation[]
  bookings      Booking[]
  reviews       Review[]
  subscriptions Subscription[]
  media         ProviderMedia[]

  @@index([type])
  @@index([verified])
}

// Portfolio/gallery foundation — architecture only, same pattern as
// EventMedia. No upload provider wired up yet.
model ProviderMedia {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category    String // e.g. "Wedding", "Catering", "Photography"
  title       String
  description String?
  basePrice   Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventRequests EventRequest[]

  @@index([providerId])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Demand: events, requests, leads, quotations, bookings
// ---------------------------------------------------------------------------

model Event {
  id           String      @id @default(cuid())
  customerId   String
  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  eventType    String // e.g. "Wedding", "Birthday", "Corporate"
  eventDate    DateTime
  startTime    String? // "HH:mm"
  endTime      String? // "HH:mm"
  city         String?
  venueType    String?
  guestCount   Int?
  budgetMin    Decimal?    @db.Decimal(10, 2)
  budgetMax    Decimal?    @db.Decimal(10, 2)
  description  String?
  requirements String?
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  eventRequests EventRequest[]
  bookings      Booking[]
  media         EventMedia[]

  @@index([customerId])
  @@index([status])
}

// Architecture only today — no upload provider wired up yet. Ready for a
// real storage provider (e.g. S3/Cloudinary) to write rows here later.
model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

// A customer's request for a specific service category on an event.
// This is what generates leads for matching providers.
model EventRequest {
  id          String              @id @default(cuid())
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category    String
  description String?
  status      EventRequestStatus  @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  leads         Lead[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([customerId])
  @@index([status])
}

// Distribution of an EventRequest to a specific provider (subscription-gated
// in a future day; today just models the relationship).
model Lead {
  id             String       @id @default(cuid())
  eventRequestId String
  eventRequest   EventRequest @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  providerId     String
  provider       Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status         LeadStatus   @default(NEW)
  viewedAt       DateTime? // set when the provider first opens the lead
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quotations Quotation[]

  @@unique([eventRequestId, providerId])
  @@index([providerId])
  @@index([status])
}

model Quotation {
  id                String          @id @default(cuid())
  leadId            String?
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  eventRequestId    String
  eventRequest      EventRequest    @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  providerId        String
  provider          Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  baseAmount        Decimal         @db.Decimal(10, 2)
  additionalCharges Decimal         @default(0) @db.Decimal(10, 2)
  discount          Decimal         @default(0) @db.Decimal(10, 2)
  tax               Decimal         @default(0) @db.Decimal(10, 2)
  finalAmount       Decimal         @db.Decimal(10, 2) // baseAmount + additionalCharges - discount + tax — always computed server-side
  details           String? // estimated delivery / logistics notes
  currency          String          @default("INR")
  validUntil        DateTime?
  status            QuotationStatus @default(DRAFT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking Booking?

  @@index([providerId])
  @@index([eventRequestId])
  @@index([status])
}

model Booking {
  id            String        @id @default(cuid())
  quotationId   String        @unique
  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customerId    String
  customer      User          @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  providerId    String
  provider      Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  advanceAmount Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments      Payment[]
  review        Review?
  conversations Conversation[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Money, trust, and feedback
// ---------------------------------------------------------------------------

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payerId        String
  payer          User          @relation(fields: [payerId], references: [id], onDelete: Restrict)
  type           PaymentType
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  method         String?
  transactionRef String?
  verifiedAt     DateTime? // set once verified — this is what flips a conversation to DIRECT
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Communication
// Rule: before verified advance payment, channel = OPERATIONS_MEDIATED
// (Customer -> Ops -> Vendor). After, channel = DIRECT (Customer <-> Vendor).
// No chat UI/logic today — this only models the future shape.
// ---------------------------------------------------------------------------

model Conversation {
  id             String              @id @default(cuid())
  channel        ConversationChannel @default(OPERATIONS_MEDIATED)
  eventRequestId String?
  eventRequest   EventRequest?       @relation(fields: [eventRequestId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([bookingId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  sentAt         DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

// ---------------------------------------------------------------------------
// Subscriptions (billing/paid-plan logic is a future day — this is shape only)
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                         String   @id @default(cuid())
  name                       String   @unique
  description                String?
  priceMonthly               Decimal  @db.Decimal(10, 2)
  leadCreditsPerMonth        Int?
  guaranteedBookingsPerMonth Int? // e.g. a "3 events/month" business guarantee
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  providerId       String
  provider         Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(TRIAL)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([providerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Support & audit
// ---------------------------------------------------------------------------

model SupportTicket {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      SupportTicketStatus  @default(OPEN)
  priority    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "booking.created", "payment.verified"
  entityType String // e.g. "Booking", "Payment"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
