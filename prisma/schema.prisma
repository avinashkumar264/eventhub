generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  FREELANCER
  OPERATIONS
  ADMIN
}

enum ProviderType {
  EVENT_COMPANY
  FREELANCER
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  OPEN
  QUOTATIONS_RECEIVED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  VIEWED
  RESPONDED
  QUOTED
  WON
  LOST
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  ADVANCE
  BALANCE
  REFUND
  PLATFORM_FEE
  SUBSCRIPTION
}

enum ConversationType {
  MEDIATED
  DIRECT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  SYSTEM
  LEAD
  QUOTATION
  BOOKING
  PAYMENT
  MESSAGE
  REVIEW
  SUBSCRIPTION
  SUPPORT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  phone          String?  @unique
  passwordHash   String?
  firstName      String?
  lastName       String?
  role           UserRole @default(CUSTOMER)
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  phoneVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider       Provider?
  customerEvents Event[]        @relation("CustomerEvents")
  quotations     Quotation[]    @relation("QuotationCustomer")
  bookings       Booking[]      @relation("CustomerBookings")
  reviews        Review[]       @relation("CustomerReviews")
  notifications  Notification[]
  supportTickets SupportTicket[]
  sentMessages   Message[]      @relation("SentMessages")
  auditLogs      AuditLog[]
  subscriptions  Subscription[] @relation("UserSubscriptions")
  payments       Payment[]

  @@index([role])
  @@index([email])
}

model Provider {
  id            String         @id @default(cuid())
  userId        String         @unique
  businessName  String
  type          ProviderType
  status        ProviderStatus @default(PENDING)
  description   String?
  gstNumber     String?        @unique
  panNumber     String?        @unique
  address       String?
  city          String?
  state         String?
  pincode       String?
  phone         String?
  email         String?
  website       String?
  portfolioUrl  String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      Service[]
  leads         Lead[]
  quotations    Quotation[]    @relation("ProviderQuotations")
  bookings      Booking[]      @relation("ProviderBookings")
  reviews       Review[]       @relation("ProviderReviews")
  subscriptions Subscription[]
  providerEvents Event[]       @relation("ProviderEvents")

  @@index([type])
  @@index([status])
  @@index([city])
}

model Service {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  description String?
  category    String
  basePrice   Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider   Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leads      Lead[]
  eventItems EventService[]

  @@index([providerId])
  @@index([category])
}

model Event {
  id            String      @id @default(cuid())
  customerId    String
  providerId    String?
  title         String
  description   String?
  eventType     String
  eventDate     DateTime?
  guestCount    Int?
  budgetMin     Decimal?    @db.Decimal(12, 2)
  budgetMax     Decimal?    @db.Decimal(12, 2)
  venue         String?
  city          String?
  state         String?
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer   User          @relation("CustomerEvents", fields: [customerId], references: [id], onDelete: Cascade)
  provider   Provider?     @relation("ProviderEvents", fields: [providerId], references: [id], onDelete: SetNull)
  services   EventService[]
  leads      Lead[]
  quotations Quotation[]
  booking    Booking?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([eventDate])
  @@index([city])
}

model EventService {
  id         String   @id @default(cuid())
  eventId    String
  serviceId  String
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
  @@index([eventId])
  @@index([serviceId])
}

model Lead {
  id         String     @id @default(cuid())
  eventId    String
  providerId String
  serviceId  String?
  status     LeadStatus @default(NEW)
  source     String?
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([eventId, providerId])
  @@index([providerId])
  @@index([status])
  @@index([expiresAt])
}

model Quotation {
  id            String          @id @default(cuid())
  eventId       String
  providerId    String
  customerId    String
  totalAmount   Decimal         @db.Decimal(12, 2)
  advanceAmount Decimal         @db.Decimal(12, 2)
  validUntil    DateTime?
  status        QuotationStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider Provider @relation("ProviderQuotations", fields: [providerId], references: [id], onDelete: Cascade)
  customer User     @relation("QuotationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@index([eventId])
  @@index([providerId])
  @@index([customerId])
  @@index([status])
}

model Booking {
  id                String        @id @default(cuid())
  eventId           String        @unique
  quotationId       String        @unique
  customerId        String
  providerId        String
  status            BookingStatus @default(PENDING_PAYMENT)
  advanceAmount     Decimal       @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  contactUnlocked   Boolean       @default(false)
  contactUnlockedAt DateTime?
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  provider      Provider       @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  payments      Payment[]
  conversations Conversation[]
  review        Review?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String?
  userId           String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  type             PaymentType
  status           PaymentStatus @default(CREATED)
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([gatewayPaymentId])
}

model Review {
  id         String   @id @default(cuid())
  customerId String
  providerId String
  bookingId  String   @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  provider Provider @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([rating])
}

model Conversation {
  id           String           @id @default(cuid())
  bookingId    String?
  type         ConversationType @default(MEDIATED)
  isUnlocked   Boolean          @default(false)
  unlockedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([bookingId])
  @@index([type])
  @@index([isUnlocked])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  durationDays     Int
  leadAccess       Boolean  @default(true)
  guaranteedEvents Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  providerId       String
  userId           String
  planId           String
  status           SubscriptionStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  eventsGuaranteed Int?
  eventsCompleted  Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  provider Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User             @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}