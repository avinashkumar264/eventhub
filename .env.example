# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# Base URL of the app (used for links, canonical URLs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Secret used to sign session JWTs — generate a strong random value, e.g.:
# openssl rand -base64 32
AUTH_SECRET=

# Razorpay (payment provider). NEXT_PUBLIC_RAZORPAY_KEY_ID is a public
# identifier, safe to expose to the browser. RAZORPAY_KEY_SECRET and
# RAZORPAY_WEBHOOK_SECRET must NEVER be exposed to the client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Reserved for future days ---
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
